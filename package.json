{
  "name": "geitonies",
  "version": "1.5.0",
  "description": "Real-estate board game for phones: 2–10 players, 3D board, online peer-to-peer play. React + TypeScript + three.js PWA.",
  "homepage": "https://petrosfs.github.io/Geitonies-mobile/",
  "repository": {
    "type": "git",
    "url": "https://github.com/petrosfs/Geitonies-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/petrosfs/Geitonies-mobile/issues"
  },
  "author": "petrosfs",
  "keywords": [
    "board-game",
    "pwa",
    "react",
    "typescript",
    "threejs",
    "webrtc",
    "peerjs",
    "multiplayer",
    "game"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @online",
    "e2e:online": "playwright test --grep @online",
    "check": "npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource/commissioner": "^5.3.0",
    "cannon-es": "^0.20.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "license": "UNLICENSED"
}